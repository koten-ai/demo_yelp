# syntax=docker/dockerfile:1
# LocalAI API image (FastAPI + kotenai-zeus-client).
#
# Build from monorepo parent (needs sibling zeus_client_python):
#   docker build -f demo_yelp/Dockerfile.backend -t local-guide-backend .
#
# Staging/prod: run this service alone behind your edge proxy, or pair with
# Dockerfile.frontend (nginx SPA that reverse-proxies /api and /static here).

FROM python:3.12-slim
WORKDIR /app

# Preinstall path dep; pyproject still lists file:../zeus_client_python which
# does not exist in the image layout — install app with --no-deps (kit pattern).
COPY zeus_client_python /tmp/zeus_client_python
COPY demo_yelp/pyproject.toml ./
COPY demo_yelp/src ./src
COPY demo_yelp/data ./data
COPY demo_yelp/config.example.json ./

RUN pip install --no-cache-dir /tmp/zeus_client_python \
    && pip install --no-cache-dir \
        "fastapi==0.115.6" \
        "uvicorn[standard]==0.34.0" \
        "httpx==0.28.1" \
        "python-multipart==0.0.20" \
    && pip install --no-cache-dir --no-deps -e . \
    && rm -rf /tmp/zeus_client_python

ENV PORT=5000
ENV ZEUS_CLIENT_CONFIG_DIR=/app
ENV ZEUS_CHAT_REQUESTS_DIR=/app/data/chat_requests
ENV CHAT_LOG_PATH=/app/data/chats.jsonl

EXPOSE 5000
CMD ["python", "-m", "local_guide"]
