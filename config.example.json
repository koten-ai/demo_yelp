{
  "build_version": "0.1.0",
  "_comment": "LocalAI yelp-demo config. Copy to config.json and fill in your keys.",

  "zeus": {
    "url": "http://host.docker.internal:8080",
    "auth_mode": "basic",
    "username": "demo_1",
    "password": "",
    "bearer_token": "",
    "session_id": "",
    "scope_credentials": {
      "yelp-demo/_default": { "username": "demo_1", "password": "" }
    },
    "scope_contracts": {
      "yelp-demo/_default": {
        "auto": {
          "contract_id": "auto_v4",
          "contract_hash": "md5:98bd0e732075dda525e834830a7f70be"
        },
        "analytics": {
          "contract_id": "analytics_v4",
          "contract_hash": "md5:af6975ab95a04f22d83ac0a0a01ab4b6"
        }
      }
    },
    "enable_durable_sessions": true
  },

  "llm_provider": {
    "label": "xAI Grok",
    "base_url": "https://api.x.ai/v1",
    "api_key": "",
    "models": [
      "grok-4.5-latest"
    ]
  },

  "chat_requests_sync": {
    "scopes": "from_contracts",
    "modes": ["auto", "analytics"],
    "on_startup": true
  },

  "default_api_version": "v2",
  "default_mode": "analytics",
  "default_sample": "yelp-demo",
  "samples": {
    "yelp-demo": {
      "bucket": "yelp-demo",
      "scope": "_default",
      "collection": "_default"
    }
  },

  "couchbase": {
    "_comment": "Optional Query-service hydrate for GET /api/suggest (FTS src_keys → card fields). Docker: host.docker.internal:8093. Also: COUCHBASE_QUERY_URL / COUCHBASE_USERNAME / COUCHBASE_PASSWORD.",
    "query_url": "http://host.docker.internal:8093",
    "username": "Administrator",
    "password": "password"
  },

  "ui": {
    "_comment": "Search loader copy. Omit business_count to use live Hub collection_counts for the default sample.",
    "corpus_label": "businesses",
    "business_count": null
  }
}
