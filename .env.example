# IMPORTANT: Copy to .env (never commit .env). LLM_API_KEY is required for agent turns.
# Zeus settings
ZEUS_URL=http://localhost:8080
ZEUS_BUCKET=yelp-demo
ZEUS_SCOPE=_default
ZEUS_COLLECTION=_default
ZEUS_MODE=analytics
HOST=127.0.0.1
PORT=5000

# Authentication mode for ZEUS. Can be "basic" or "bearer". If using bearer, set ZEUS_BEARER_TOKEN instead of ZEUS_USERNAME and ZEUS_PASSWORD.
ZEUS_AUTH_MODE=basic
ZEUS_USERNAME=demo_1
ZEUS_PASSWORD=
# ZEUS_BEARER_TOKEN=

# LLM API settings
# Grok: https://api.x.ai/v1
# OpenAI: https://api.openai.com/v1
# Anthropic: https://api.anthropic.com/v1
# Gemini (OpenAI-compatible): https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-4.5-latest

# Couchbase Query service (port 8093 on the Zeus host).
# Review text, map coordinates, and business detail come from N1QL here.
COUCHBASE_QUERY_URL=http://localhost:8093
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=
